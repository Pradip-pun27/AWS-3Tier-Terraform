#!/bin/bash
set -e

# 1. Install Apache2, PHP 8.3, PHP MySQL PDO driver, and MySQL client
export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get install -y apache2 php libapache2-mod-php php-mysql mysql-client

# 2. Wait for RDS MySQL to accept connections, then initialize schema idempotently
until mysql -h "${db_host}" -u "${db_username}" -p"${db_password}" -e "SELECT 1;" >/dev/null 2>&1; do
  echo "Waiting for RDS MySQL endpoint..."
  sleep 5
done

mysql -h "${db_host}" -u "${db_username}" -p"${db_password}" "${db_name}" << 'SQL'
CREATE TABLE IF NOT EXISTS tasks (
    id INT AUTO_INCREMENT PRIMARY KEY,
    title VARCHAR(255) NOT NULL,
    course VARCHAR(100) NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
INSERT INTO tasks (title, course)
SELECT 'Deploy 3-Tier AWS Infrastructure via Terraform', 'Cloud & DevOps'
WHERE NOT EXISTS (SELECT 1 FROM tasks);
SQL

# 3. Write database configuration injected by Terraform
cat << 'EOF' > /var/www/html/config.php
<?php
define('DB_HOST', '${db_host}');
define('DB_NAME', '${db_name}');
define('DB_USER', '${db_username}');
define('DB_PASS', '${db_password}');
EOF
chmod 640 /var/www/html/config.php
chown root:www-data /var/www/html/config.php

# 4. Deploy PHP Backend REST API (PDO + Prepared Statements)
rm -f /var/www/html/index.html
cat << 'EOF' > /var/www/html/api.php
<?php
header('Content-Type: application/json');
require_once __DIR__ . '/config.php';

try {
    $dsn = "mysql:host=" . DB_HOST . ";dbname=" . DB_NAME . ";charset=utf8mb4";
    $pdo = new PDO($dsn, DB_USER, DB_PASS, [
        PDO::ATTR_ERRMODE            => PDO::ERRMODE_EXCEPTION,
        PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
    ]);

    if ($_SERVER['REQUEST_METHOD'] === 'POST') {
        $payload = json_decode(file_get_contents('php://input'), true);
        if (!empty($payload['title']) && !empty($payload['course'])) {
            $stmt = $pdo->prepare("INSERT INTO tasks (title, course) VALUES (:title, :course)");
            $stmt->execute([
                ':title'  => htmlspecialchars(trim($payload['title']), ENT_QUOTES, 'UTF-8'),
                ':course' => htmlspecialchars(trim($payload['course']), ENT_QUOTES, 'UTF-8'),
            ]);
            http_response_code(201);
            echo json_encode(['status' => 'created']);
            exit;
        }
        http_response_code(400);
        echo json_encode(['error' => 'Title and course are required']);
        exit;
    }

    if ($_SERVER['REQUEST_METHOD'] === 'DELETE') {
        $id = isset($_GET['id']) ? (int) $_GET['id'] : 0;
        if ($id > 0) {
            $stmt = $pdo->prepare("DELETE FROM tasks WHERE id = :id");
            $stmt->execute([':id' => $id]);
            echo json_encode(['status' => 'deleted']);
            exit;
        }
    }

    $stmt = $pdo->query("SELECT id, title, course, created_at FROM tasks ORDER BY id DESC");
    echo json_encode([
        'server_private_ip' => $_SERVER['SERVER_ADDR'] ?? 'unknown',
        'hostname'          => gethostname(),
        'tasks'             => $stmt->fetchAll(),
    ]);
} catch (PDOException $e) {
    http_response_code(500);
    echo json_encode(['error' => 'Database error: ' . $e->getMessage()]);
}
EOF

# 5. Deploy HTML5 + CSS3 + Vanilla JS Frontend (Note $$ escaping for JS template literals)
cat << 'EOF' > /var/www/html/index.html
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AWS 3-Tier Auto-Scaled PHP & MySQL App</title>
  <style>
    * { box-sizing: border-box; }
    body { font-family: system-ui, -apple-system, sans-serif; background: #0f172a; color: #f8fafc; max-width: 720px; margin: 40px auto; padding: 0 20px; }
    .card { background: #1e293b; padding: 28px; border-radius: 14px; box-shadow: 0 10px 30px rgba(0,0,0,0.35); border: 1px solid #334155; }
    h2 { margin-top: 0; }
    .badge { display: inline-block; background: #0284c7; color: #f0f9ff; padding: 6px 12px; border-radius: 999px; font-size: 0.85rem; font-weight: 600; margin-bottom: 20px; }
    form { display: flex; gap: 10px; margin-bottom: 22px; flex-wrap: wrap; }
    input { flex: 1; min-width: 180px; padding: 11px 14px; border-radius: 8px; border: 1px solid #475569; background: #0f172a; color: #f8fafc; font-size: 0.95rem; }
    button.primary { padding: 11px 20px; background: #22c55e; color: #052e16; font-weight: 700; border: none; border-radius: 8px; cursor: pointer; }
    button.primary:hover { background: #16a34a; }
    button.del { background: transparent; color: #f87171; border: 1px solid #7f1d1d; border-radius: 6px; padding: 4px 10px; cursor: pointer; font-size: 0.8rem; }
    ul { list-style: none; padding: 0; margin: 0; }
    li { background: #0f172a; padding: 14px 16px; border-radius: 10px; margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center; gap: 12px; border: 1px solid #1e293b; }
    .meta { color: #94a3b8; font-size: 0.8rem; display: block; margin-top: 4px; }
  </style>
</head>
<body>
  <div class="card">
    <h2>AWS 3-Tier Study Tracker (Terraform + ASG)</h2>
    <div class="badge" id="server-info">Connecting to Private PHP Application Tier...</div>
    <form id="task-form">
      <input type="text" id="title" placeholder="Task (e.g., Test Auto Scaling)" required />
      <input type="text" id="course" placeholder="Subject (e.g., Web Technology)" required />
      <button class="primary" type="submit">Save to RDS</button>
    </form>
    <ul id="task-list"></ul>
  </div>

  <script>
    async function loadTasks() {
      const res = await fetch('api.php');
      const data = await res.json();
      document.getElementById('server-info').textContent =
        `Served by Private EC2: $${data.server_private_ip} ($${data.hostname}) | DB: Private RDS MySQL`;
      const list = document.getElementById('task-list');
      list.innerHTML = data.tasks.map(t => `
        <li>
          <div>
            <strong>$${t.title}</strong> &mdash; <span>$${t.course}</span>
            <span class="meta">Created: $${t.created_at}</span>
          </div>
          <button class="del" onclick="deleteTask($${t.id})">Delete</button>
        </li>
      `).join('');
    }

    async function deleteTask(id) {
      await fetch(`api.php?id=$${id}`, { method: 'DELETE' });
      loadTasks();
    }

    document.getElementById('task-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      await fetch('api.php', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          title: document.getElementById('title').value,
          course: document.getElementById('course').value
        })
      });
      e.target.reset();
      loadTasks();
    });

    loadTasks();
  </script>
</body>
</html>
EOF

# 6. Enable and restart Apache2
systemctl enable --now apache2
systemctl restart apache2